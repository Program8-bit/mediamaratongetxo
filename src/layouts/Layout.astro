---
import '../styles/global.css';
import { getSettings, getContacto } from '../lib/site-data';
import { getCollection } from 'astro:content';
import { t, pathWithLang, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  noFooterGap?: boolean;
  lang?: Lang;
}

const { title, description, noFooterGap = false, lang = 'es' } = Astro.props;
const settings = getSettings();
const strings = t[lang];
const nombreEvento = (lang === 'eu' && settings.nombreEventoEu) || settings.nombreEvento;
const enlaceInscripcion = (lang === 'eu' && settings.enlaceInscripcionEu) || settings.enlaceInscripcion;
const home = lang === 'eu' ? '/eu/' : '/';

const nav = [
  { href: home, label: strings.nav.inicio },
  { href: pathWithLang('/carrera', lang), label: strings.nav.carrera },
  { href: pathWithLang('/dorsales', lang), label: strings.nav.dorsales },
  { href: pathWithLang('/faq', lang), label: strings.nav.faq },
];

const otroIdioma: Lang = lang === 'es' ? 'eu' : 'es';
const enlaceOtroIdioma = pathWithLang(Astro.url.pathname, otroIdioma);

const orden = { oro: 0, plata: 1, bronce: 2, colaborador: 3 };
const patrocinadores = (await getCollection('patrocinadores')).sort(
  (a, b) => orden[a.data.nivel] - orden[b.data.nivel]
);
const contacto = getContacto();
---

<!doctype html>
<html lang={lang} style={`--color-primary: ${settings.colorPrimario || '#0b3d5c'}; --color-accent: ${settings.colorAcento || '#d62828'};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-getxo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-getxo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Anton&display=swap"
      rel="stylesheet"
    />
    <title>{title} · {nombreEvento}</title>
    <meta name="description" content={description || strings.meta.description} />
    <link rel="alternate" hreflang="es" href={pathWithLang(Astro.url.pathname, 'es')} />
    <link rel="alternate" hreflang="eu" href={pathWithLang(Astro.url.pathname, 'eu')} />
  </head>
  <body>
    <header class="site-header" id="siteHeader">
      <div class="container site-header-inner">
        <div class="site-nav-wrap" id="siteNavWrap">
          <nav class="site-nav">
            <ul>
              {nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
              <li>
                <a href={enlaceOtroIdioma} class="lang-switch" aria-label={strings.langSwitch.aria}>
                  {strings.langSwitch.label}
                </a>
              </li>
              <li>
                <a class="is-cta" href={enlaceInscripcion} target="_blank" rel="noopener">
                  {strings.nav.inscribete}
                </a>
              </li>
            </ul>
          </nav>
        </div>
        <button class="nav-toggle" id="navToggle" aria-label={strings.nav.abrirMenu} aria-expanded="false" aria-controls="siteNavWrap">
          <span></span><span></span><span></span>
        </button>
        <a href={home} class="site-logo">
          <img src="/favicon-getxo.png" alt={nombreEvento} />
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer style={`background: var(--color-primary-dark); color: #fff; margin-top: ${noFooterGap ? '0' : '3rem'};`}>
      <div class="container footer-contact">
        <h2>{strings.footer.contacto}</h2>
        <div class="footer-contact-grid">
          <div>
            <p>
              {strings.footer.email}<br />
              <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
            </p>
          </div>
          <div>
            <p>
              {strings.footer.telefono}<br />
              {contacto.telefono}
            </p>
          </div>
          <div>
            <p>
              {strings.footer.direccion}<br />
              {contacto.direccion}
            </p>
          </div>
        </div>
        {(contacto.instagram || contacto.facebook) && (
          <div class="footer-social">
            {contacto.instagram && (
              <a href={contacto.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="footer-social-link">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none" />
                </svg>
              </a>
            )}
            {contacto.facebook && (
              <a href={contacto.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="footer-social-link">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M15 8.5h2.5V5H15c-2.2 0-4 1.8-4 4v2H9v3.5h2V19h3.5v-4.5H17l.5-3.5h-3V9c0-.55.45-1 1-1z" />
                </svg>
              </a>
            )}
          </div>
        )}
      </div>

      <div class="container footer-orgs">
        <div class="footer-orgs-grid">
          {patrocinadores.length > 0 && (
            <div class="footer-orgs-col">
              <p class="footer-orgs-label">{strings.footer.patrocinadores}</p>
              <div class="footer-orgs-logos">
                {patrocinadores.map((p) => {
                  const Wrapper = p.data.url ? 'a' : 'div';
                  return (
                    <Wrapper
                      href={p.data.url}
                      target={p.data.url ? '_blank' : undefined}
                      rel={p.data.url ? 'noopener' : undefined}
                      class="footer-orgs-badge"
                    >
                      <img src={p.data.logo} alt={p.data.nombre} style="max-height: 40px; max-width: 120px;" />
                    </Wrapper>
                  );
                })}
              </div>
            </div>
          )}
          <div class="footer-orgs-col">
            <p class="footer-orgs-label">{strings.footer.organizadoPor}</p>
            <div class="footer-orgs-logos">
              <span class="footer-orgs-badge">
                <img src="/images/getxo_atletismo.jpeg" alt="Club Atlético Getxo" style="height: 44px; width: auto; display: block;" />
              </span>
            </div>
          </div>
          <div class="footer-orgs-col">
            <p class="footer-orgs-label">{strings.footer.homologadoPor}</p>
            <div class="footer-orgs-logos">
              <span class="footer-orgs-badge">
                <img src="/images/rfea.jpeg" alt="RFEA" style="height: 44px; width: auto; display: block;" />
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="container" style="padding-top: 2rem; padding-bottom: 1.5rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <p style="margin: 0; color: rgba(255,255,255,0.6);">
          {strings.footer.desarrolladoPor} <a href="https://belvedere.eus" target="_blank" rel="noopener" style="color: #fff;">Belvedere Agency</a>
        </p>
        <a href={pathWithLang('/legal', lang)} style="color: #fff;">{strings.footer.avisoLegal}</a>
      </div>
    </footer>

    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.href = '/admin/';
            });
          }
        });
      }
    </script>

    <script>
      const header = document.getElementById('siteHeader');
      const toggle = document.getElementById('navToggle');

      if (header && toggle) {
        const closeMenu = () => {
          header.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        };

        toggle.addEventListener('click', () => {
          const isOpen = header.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });

        header.querySelectorAll('.site-nav a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 860) closeMenu();
        });
      }
    </script>
  </body>
</html>
