---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const fotos = await getCollection('galeria');
---

<Layout title="Galería">
  <section class="section">
    <div class="container">
      <h1>Galería</h1>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        {fotos.map((foto) => (
          <figure style="margin: 0;">
            <img src={foto.data.imagen} alt={foto.data.alt} style="width: 100%; border-radius: var(--radius);" />
            <figcaption style="color: var(--color-text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
              {foto.data.anio}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Layout>
