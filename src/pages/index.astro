---
import Layout from '../layouts/Layout.astro';
import { getSettings } from '../lib/site-data';

const settings = getSettings();
---

<Layout title="Inicio" noFooterGap>
  <section style="flex: 1; display: flex; align-items: center; background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark)); color: #fff;">
    <div class="container" style="padding: 5.5rem 1.25rem; text-align: center;">
      <img
        src="/images/logo-otso.jpg"
        alt={settings.nombreEvento}
        style="height: 150px; width: auto; border-radius: 14px; box-shadow: 0 8px 24px rgba(0,0,0,0.35); margin-bottom: 2rem;"
      />
      <h1 style="color: #fff; font-size: 3.5rem; margin-bottom: 0.75rem;">{settings.nombreEvento}</h1>
      <p style="font-size: 1.6rem; margin-bottom: 1.75rem;">{settings.subtitulo}</p>
      <p style="font-size: 1.3rem; margin-bottom: 2.25rem;">
        📅 {settings.fecha} · 📍 {settings.lugarSalida} · 🕒 {settings.horaSalida}
      </p>
      <a class="btn" href={settings.enlaceInscripcion} target="_blank" rel="noopener" style="font-size: 1.2rem; padding: 1rem 2.25rem;">
        Inscríbete
      </a>
    </div>
  </section>
</Layout>
