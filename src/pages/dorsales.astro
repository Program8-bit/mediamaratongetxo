---
import Layout from '../layouts/Layout.astro';
import { getDorsales } from '../lib/site-data';

const dorsales = getDorsales();
---

<Layout title="Recogida de dorsales">
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero-title">
        <span>Recogida de</span>
        <span>dorsales</span>
      </h1>
    </div>
  </section>

  <section class="page-section section">
    <div class="container">
      <div class="info-grid">
        <div class="info-card">
          <h2>Cuándo y dónde</h2>
          <p><strong>Lugar:</strong> {dorsales.lugar}</p>
          <p><strong>Fecha:</strong> {dorsales.fecha}</p>
          <p style="white-space: pre-line;"><strong>Horario:</strong>{'\n'}{dorsales.horario}</p>
          {dorsales.aviso && (
            <p style="color: var(--color-text-muted); white-space: pre-line;">{dorsales.aviso}</p>
          )}
        </div>
        <div class="info-card">
          <h2>Qué llevar</h2>
          <p style="white-space: pre-line;">{dorsales.queLlevar}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
