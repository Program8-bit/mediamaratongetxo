---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const faqs = await getCollection('faq');
const ordenadas = [...faqs].sort((a, b) => a.data.orden - b.data.orden);

function linkify(texto: string) {
  const escapado = texto
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escapado.replace(
    /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)|(https?:\/\/[^\s]+)/g,
    (_match, etiqueta, urlConEtiqueta, urlSuelta) =>
      etiqueta
        ? `<a href="${urlConEtiqueta}" target="_blank" rel="noopener">${etiqueta}</a>`
        : `<a href="${urlSuelta}" target="_blank" rel="noopener">${urlSuelta}</a>`,
  );
}

const columnaIzquierda = ordenadas.filter((_, i) => i % 2 === 0);
const columnaDerecha = ordenadas.filter((_, i) => i % 2 === 1);
---

<Layout title="Preguntas frecuentes">
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero-title">
        <span>Preguntas</span>
        <span>frecuentes</span>
      </h1>
    </div>
  </section>

  <section class="page-section section">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-column">
          {columnaIzquierda.map((item, i) => (
            <div class:list={['faq-card', { 'is-open': i === 0 }]}>
              <button class="faq-card-toggle" aria-expanded={i === 0}>
                <span class="faq-question">{item.data.pregunta}</span>
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer">
                <p set:html={linkify(item.data.respuesta)} />
              </div>
            </div>
          ))}
        </div>
        <div class="faq-column">
          {columnaDerecha.map((item) => (
            <div class="faq-card">
              <button class="faq-card-toggle" aria-expanded="false">
                <span class="faq-question">{item.data.pregunta}</span>
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer">
                <p set:html={linkify(item.data.respuesta)} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .faq-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-card {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: background 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .faq-card-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: 1.35rem 1.5rem;
    cursor: pointer;
    font-family: inherit;
  }

  .faq-question {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .faq-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    font-size: 1.3rem;
    color: var(--color-text-muted);
    transition: transform 0.25s var(--ease), color 0.2s var(--ease);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s var(--ease);
  }

  .faq-answer p {
    margin: 0 1.5rem 1.35rem;
    color: var(--color-text-muted);
    white-space: pre-line;
  }

  .faq-card.is-open {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-dark));
    box-shadow: var(--shadow-md);
  }

  .faq-card.is-open .faq-question {
    color: #fff;
  }

  .faq-card.is-open .faq-icon {
    color: #fff;
    transform: rotate(45deg);
  }

  .faq-card.is-open .faq-answer p {
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 780px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.faq-card').forEach((card) => {
    const toggle = card.querySelector<HTMLButtonElement>('.faq-card-toggle');
    const answer = card.querySelector<HTMLElement>('.faq-answer');
    if (!toggle || !answer) return;

    if (card.classList.contains('is-open')) {
      answer.style.maxHeight = `${answer.scrollHeight}px`;
    }

    toggle.addEventListener('click', () => {
      const isOpen = card.classList.contains('is-open');

      document.querySelectorAll('.faq-card.is-open').forEach((open) => {
        if (open !== card) {
          open.classList.remove('is-open');
          open.querySelector<HTMLButtonElement>('.faq-card-toggle')?.setAttribute('aria-expanded', 'false');
          const openAnswer = open.querySelector<HTMLElement>('.faq-answer');
          if (openAnswer) openAnswer.style.maxHeight = '0px';
        }
      });

      card.classList.toggle('is-open', !isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
      answer.style.maxHeight = isOpen ? '0px' : `${answer.scrollHeight}px`;
    });
  });
</script>
