---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entradas = await getCollection('legal');
const legal = entradas.find((e) => e.data.lang === lang) ?? entradas.find((e) => e.data.lang === 'es');
const { Content } = await render(legal!);
---

<Layout title={legal!.data.titulo} lang={lang}>
  <section class="section">
    <div class="container">
      <h1>{legal!.data.titulo}</h1>
      <Content />
    </div>
  </section>
</Layout>
